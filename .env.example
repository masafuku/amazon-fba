KEEPA_API_KEY=your_keepa_api_key_here
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=supersecret
EMAIL_FROM=you@example.com
EMAIL_TO=recipient@example.com
LINE_NOTIFY_TOKEN=your_line_notify_token_here
SEARCH_KEYWORD=import japan
SEARCH_CATEGORY=All
US_MAX_RESULTS=20
PRICE_DIFF_THRESHOLD=0.30
USD_TO_JPY=150.0
SALES_RANK_THRESHOLD=50000
# Used by keepa_mcp/ (MCP server) as the fallback sell-side marketplace
KEEPA_DEFAULT_DOMAIN=US
# keepa_mcp/ local SQLite cache (keepa_mcp/cache.sqlite3) - conserves tokens
# on repeated ASIN/category/UPC lookups. Tools accept force_refresh=true to
# bypass it when you have spare token budget and want current prices/ranks.
KEEPA_CACHE_ENABLED=true
KEEPA_CACHE_TTL_PRODUCT_HOURS=6
KEEPA_CACHE_TTL_FINDER_HOURS=6
KEEPA_CACHE_TTL_CATEGORY_HOURS=720
