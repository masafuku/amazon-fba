KEEPA_API_KEY=your_keepa_api_key_here
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=you@example.com
EMAIL_PASSWORD=supersecret
EMAIL_FROM=you@example.com
EMAIL_TO=recipient@example.com
# LINE Notify は2025年3月末でサービス終了済み。後継のLINE Messaging APIを使用。
# Channel Access Token: LINE Developers Console > 対象チャンネル(Messaging API) >
# 「Messaging API設定」タブ > 「チャネルアクセストークン(長期)」から発行。
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
# 個人利用のBotなら空のままでOK(友だち全員へのbroadcastで送信)。
# 特定のUser IDへpushしたい場合のみ指定(Uで始まる32桁の16進数文字列。
# LINE ID/表示名ではない点に注意)。
LINE_USER_ID=
# NETSEA(卸売り仕入れサイト)のAPIアクセストークン。
# アカウント設定(https://www.netsea.jp/account/)のAPI設定画面から発行(有効期限180日)。
# netsea_sourcing.py / netsea_client.py が使用。未設定でも他機能には影響しない。
NETSEA_ACCESS_TOKEN=
SEARCH_KEYWORD=import japan
SEARCH_CATEGORY=All
US_MAX_RESULTS=20
PRICE_DIFF_THRESHOLD=0.30
USD_TO_JPY=150.0
SALES_RANK_THRESHOLD=50000
# Used by keepa_mcp/ (MCP server) as the fallback sell-side marketplace
KEEPA_DEFAULT_DOMAIN=US
# keepa_mcp/ local SQLite cache (keepa_mcp/cache.sqlite3) - conserves tokens
# on repeated ASIN/category/UPC lookups. Tools accept force_refresh=true to
# bypass it when you have spare token budget and want current prices/ranks.
KEEPA_CACHE_ENABLED=true
KEEPA_CACHE_TTL_PRODUCT_HOURS=6
KEEPA_CACHE_TTL_FINDER_HOURS=6
KEEPA_CACHE_TTL_CATEGORY_HOURS=720

# 収支・在庫ダッシュボード(sp_api/, sp_api_sync.py)。Keepaには依存しない
# — 出品済み商品の売上・実手数料・FBA在庫を取得する。
# Seller Central > プログラムとアプリ > アプリ開発者として登録する で
# Private Appを登録(本人確認20分) -> 自己承認(Authorize)でRefresh Token発行。
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
SP_API_REGION=na
SP_API_MARKETPLACE_ID=ATVPDKIKX0DER

# Gmail API(読み取り専用、sd_email_parser.py)。Super Deliveryの注文確定
# メールから仕入原価・数量を自動取得する。Google Cloud ConsoleでOAuth
# クライアントを作成し、scope=https://www.googleapis.com/auth/gmail.readonly
# で自己承認してRefresh Tokenを発行する。未設定でも他機能には影響しない。
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
